<Window x:Class="test1.Window_.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:test1.Window_"
        mc:Ignorable="d"
        Title="AuthWindow" Height="400" Width="300">
    <Grid>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Логин:"/>
            <TextBox x:Name="logintb" Width="220" Text="admin"/>
            <TextBlock Text="Пароль:" Margin="0,10"/>
            <PasswordBox x:Name="passtb" Width="220" Password="123"/>

            <Button Content="Войти" Margin="0,25" Click="Button_Click"/>
            <TextBlock Text="" x:Name="errortb" Foreground="Red"/>
            
        </StackPanel>
    </Grid>
</Window>
