<Window x:Class="test1.Window_.CRUDWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:test1.Window_"
        mc:Ignorable="d"
        Title="CRUDWindow" Height="350" Width="350">
    <Grid>
        <StackPanel Margin="15">
            <TextBlock Text="Марка:"/>
            <TextBox x:Name="tbBrand" Margin="0,2,0,10"/>
            <TextBlock Text="Модель:"/>
            <TextBox x:Name="tbModel" Margin="0,2,0,10"/>
            <TextBlock Text="Год:"/>
            <TextBox x:Name="tbYear" Margin="0,2,0,10"/>
            <TextBlock Text="Номер:"/>
            <TextBox x:Name="tbPlate" Margin="0,2,0,10"/>
            <TextBlock Text="Цена:"/>
            <TextBox x:Name="tbPrice" Margin="0,2,0,15"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Click="Cancel" Width="80" Margin="0,0,10,0"/>
                <Button Content="Сохранить" Click="Save" Width="80"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
