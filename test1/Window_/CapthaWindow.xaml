<Window x:Class="test1.Window_.CapthaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:test1.Window_"
        mc:Ignorable="d"
        Title="CapthaWindow" Height="400" Width="385">
    <StackPanel Margin="10">
        <TextBlock Text="Нажми на картинки, чтобы они встали ровно:" TextAlignment="Center" Margin="5"/>
        <UniformGrid x:Name="G" Rows="2" Columns="2" Width="180" Height="180" MouseLeftButtonDown="Click">
            <Image Source="/Material_/CapthaIMG/1.png" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <RotateTransform Angle="90"/>
                </Image.RenderTransform>
            </Image>
            <Image Source="/Material_/CapthaIMG/2.png" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <RotateTransform Angle="180"/>
                </Image.RenderTransform>
            </Image>
            <Image Source="/Material_/CapthaIMG/3.png" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <RotateTransform Angle="270"/>
                </Image.RenderTransform>
            </Image>
            <Image Source="/Material_/CapthaIMG/4.png" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <RotateTransform Angle="90"/>
                </Image.RenderTransform>
            </Image>
        </UniformGrid>
        <Button Content="Подтвердить" x:Name="Btn" IsEnabled="False" Click="Ok" Height="30" Margin="0,10,0,0"/>
    </StackPanel>
</Window>
