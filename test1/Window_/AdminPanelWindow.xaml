<Window x:Class="test1.Window_.AdminPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:test1.Window_"
        mc:Ignorable="d"
        Title="AdminPanelWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40*"/>
            <RowDefinition Height="137*"/>
            <RowDefinition Height="40*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="10" HorizontalAlignment="Center">
            <TextBlock Text="Название компании" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="5,5,5,5">
            <TextBox x:Name="tbSearch" Margin="0,0,0,5" TextChanged="TbSearch_TextChanged"/>
            <DataGrid x:Name="dgTab" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" Height="Auto"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" >
            <Button Content="Обновление" Click="Button_Click" Margin="10" Height="25" Width="100"/>
            <Button Content="Добавление" Click="BtnAdd_Click" Margin="10" Height="25" Width="100"/>
            <Button Content="Редактирование" Click="BtnEdit_Click" Margin="10" Height="25" Width="100"/>
            <Button Content="Удаление" Click="BtnDel_Click" Margin="10" Height="25" Width="100"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Uid="1" Content="Обновление" Margin="10" Height="25" Width="100" Click="Button_Click"/>
            <Button x:Uid="2" Content="Добавление" Margin="10" Height="25" Width="100"/>
            <Button x:Uid="3" Content="Редактирование" Margin="10" Height="25" Width="100"/>
            <Button x:Uid="4" Content="Удаление" Margin="10" Height="25" Width="100"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Uid="1" Content="Обновление" Margin="10" Height="25" Width="100" Click="Button_Click"/>
            <Button x:Uid="2" Content="Добавление" Margin="10" Height="25" Width="100"/>
            <Button x:Uid="3" Content="Редактирование" Margin="10" Height="25" Width="100"/>
            <Button x:Uid="4" Content="Удаление" Margin="10" Height="25" Width="100"/>
        </StackPanel>
    </Grid>
</Window>
